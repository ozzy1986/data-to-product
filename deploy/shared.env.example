# Настройки сервиса на VPS (shared/.env). deploy.sh создаёт файл из этого шаблона при первом деплое.
# Те же переменные, что в .env.example в корне проекта; ключ — только здесь, права файла 600.
# Без модели сайт показывает сохранённые примеры, а генерация отвечает 503.
LLM_PROVIDER=ollama
LLM_URL=http://127.0.0.1:11434
LLM_MODEL=gemma3:4b
LLM_TIMEOUT=240
LLM_REPAIRS=2
QUEUE_LIMIT=4

# Облачная модель:
# LLM_PROVIDER=anthropic
# LLM_API_KEY=
# LLM_URL=
# LLM_MODEL=
# LLM_CONCURRENCY=4
