# Скопируйте в .env (он в .gitignore) и оставьте один из вариантов.
# Переменные окружения, заданные в системе, важнее этого файла.

# --- Anthropic (Claude) ---
LLM_PROVIDER=anthropic
LLM_API_KEY=
# LLM_MODEL=claude-opus-5-5

# --- OpenAI или любой OpenAI-совместимый API ---
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_URL=https://api.openai.com/v1
#   Gemini:     LLM_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.0-flash
#   DeepSeek:   LLM_URL=https://api.deepseek.com                                  LLM_MODEL=deepseek-chat
#   OpenRouter: LLM_URL=https://openrouter.ai/api/v1                              LLM_MODEL=<модель из каталога>

# --- Локальная модель через Ollama, ключ не нужен ---
# LLM_PROVIDER=ollama
# LLM_MODEL=gemma3:4b

# С облачной моделью можно генерировать несколько карточек одновременно.
# LLM_CONCURRENCY=4
